# Dev image for s3-inv-db-server: Go toolchain + air for hot-reload.
# Source is volume-mounted at /app at runtime; this image only carries the
# toolchain and pre-downloaded modules.

FROM golang:1.25-alpine

# git: go modules over git, plus safe.directory tweak for volume-mounted source.
# tini: clean PID 1 so Ctrl+C in `docker compose up` propagates to air.
# wget: healthcheck.
RUN apk add --no-cache git tini wget

WORKDIR /app

# Pin air to the version the Makefile uses so dev container and host match.
ARG AIR_VERSION=v1.61.7
RUN go install github.com/air-verse/air@${AIR_VERSION}

# Volume-mounted source is owned by host UID; tell git it's safe.
RUN git config --global --add safe.directory /app

# Pre-download dependencies (cached layer).
COPY go.mod go.sum ./
RUN go mod download

EXPOSE 8080

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["air", "-c", ".air.toml"]
